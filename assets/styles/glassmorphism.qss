/* ========================================================================= */
/* CAELUM - HOJA DE ESTILOS GLASSMORPHISM ESTILO APPLE                       */
/* ========================================================================= */

/* Reset Global */
QWidget {
    font-family: -apple-system, "SF Pro Display", "SF Pro Text", "Inter", "Segoe UI", "Ubuntu", sans-serif;
    color: #ffffff;
    font-size: 14px;
    selection-background-color: rgba(255, 255, 255, 0.3);
    selection-color: #ffffff;
}

/* Ventana y ScrollArea Transparentes */
QMainWindow, QScrollArea, QScrollArea > QWidget > QWidget {
    background: transparent;
}

QScrollArea {
    border: none;
}

/* Tarjeta Bento Base con Efecto Vidrio */
QFrame.tarjetaBento {
    background-color: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.20);
    border-radius: 20px;
}

QFrame.tarjetaBento:hover {
    background-color: rgba(255, 255, 255, 0.16);
    border: 1px solid rgba(255, 255, 255, 0.28);
}

/* Encabezados de Tarjetas Bento */
QLabel#tituloBento {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.8px;
    color: rgba(255, 255, 255, 0.65);
    text-transform: uppercase;
}

/* Textos de la Cabecera Principal */
QLabel#ciudadCabecera {
    font-size: 32px;
    font-weight: 500;
    letter-spacing: -0.5px;
}

QLabel#paisCabecera {
    font-size: 14px;
    font-weight: 400;
    color: rgba(255, 255, 255, 0.75);
}

QLabel#temperaturaGigante {
    font-size: 84px;
    font-weight: 200;
    letter-spacing: -3px;
    margin: -10px 0px;
}

QLabel#condicionCabecera {
    font-size: 20px;
    font-weight: 400;
    color: rgba(255, 255, 255, 0.95);
}

QLabel#rangoHoyCabecera {
    font-size: 15px;
    font-weight: 400;
    color: rgba(255, 255, 255, 0.80);
}

/* Píldoras de Fechas (Gregoriana & Hijri) */
QFrame#pildoraFecha {
    background-color: rgba(255, 255, 255, 0.14);
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 12px;
    padding: 4px 12px;
}

QLabel#textoPildoraFecha {
    font-size: 12px;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.90);
}

/* Barra de Búsqueda Flotante */
QFrame#contenedorBusqueda {
    background-color: rgba(255, 255, 255, 0.15);
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 16px;
}

QFrame#contenedorBusqueda:focus-within {
    background-color: rgba(255, 255, 255, 0.22);
    border: 1px solid rgba(255, 255, 255, 0.45);
}

QLineEdit#inputBusqueda {
    background: transparent;
    border: none;
    font-size: 14px;
    font-weight: 400;
    color: #ffffff;
    padding: 6px 4px;
}

QLineEdit#inputBusqueda::placeholder {
    color: rgba(255, 255, 255, 0.55);
}

QPushButton#botonLimpiarBusqueda {
    background: transparent;
    border: none;
    color: rgba(255, 255, 255, 0.7);
    font-size: 14px;
    font-weight: bold;
    border-radius: 10px;
    padding: 2px 6px;
}

QPushButton#botonLimpiarBusqueda:hover {
    background-color: rgba(255, 255, 255, 0.2);
    color: #ffffff;
}

/* Lista Desplegable de Resultados de Búsqueda */
QListWidget#listaSugerencias {
    background-color: rgba(30, 40, 55, 0.95);
    border: 1px solid rgba(255, 255, 255, 0.20);
    border-radius: 14px;
    padding: 6px;
    outline: none;
}

QListWidget#listaSugerencias::item {
    background: transparent;
    border-radius: 8px;
    padding: 8px 12px;
    color: #ffffff;
    margin: 2px 0px;
}

QListWidget#listaSugerencias::item:hover,
QListWidget#listaSugerencias::item:selected {
    background-color: rgba(255, 255, 255, 0.20);
}

/* Barras de Desplazamiento Minimalistas */
QScrollBar:vertical {
    background: transparent;
    width: 6px;
    margin: 4px 0px;
}

QScrollBar::handle:vertical {
    background: rgba(255, 255, 255, 0.25);
    min-height: 30px;
    border-radius: 3px;
}

QScrollBar::handle:vertical:hover {
    background: rgba(255, 255, 255, 0.45);
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
    border: none;
}

